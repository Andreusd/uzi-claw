[Unit]
Description=Antigravity CLI Telegram Bot Bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/Documents/Projects/AntigravityTelegramBridge
ExecStart=%h/Documents/Projects/AntigravityTelegramBridge/.venv/bin/python3 %h/Documents/Projects/AntigravityTelegramBridge/main.py
Restart=always
RestartSec=5s
Environment=PYTHONUNBUFFERED=1
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=default.target
