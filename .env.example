# Telegram Bot Token from @BotFather
TELEGRAM_TOKEN=your_telegram_bot_token_here

# Path to the Antigravity CLI executable (default: ~/.local/bin/agy)
AGY_BIN_PATH=/home/username/.local/bin/agy

# Default working directory for the agent (defaults to user home)
DEFAULT_WORKSPACE=/home/username

# Comma-separated list of additional allowed Telegram IDs or usernames (optional, authorized_users.txt is also checked)
TELEGRAM_ALLOWED_USERS=your_telegram_username_or_id

# Enable --dangerously-skip-permissions by default so headless tool calls work smoothly
AUTOPILOT_DEFAULT=true

# Execution mode: "accept-edits" or "plan" (default: empty for standard interactive mode)
DEFAULT_MODE=

# Optional model and reasoning effort (e.g., low, medium, high, xhigh, max)
DEFAULT_MODEL=
DEFAULT_EFFORT=

# Prepend Telegram context to prompts so agy knows messages originate from Telegram (default: true)
INJECT_TELEGRAM_CONTEXT=true
